/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self'; font-src 'self'; img-src 'self' blob: data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/sw.js
  Cache-Control: no-cache

/favicon.ico
  Cache-Control: public, max-age=31536000
  Content-Type: image/x-icon

/ocr/*
  Cache-Control: public, max-age=31536000, immutable

/pdf/6.2.108/*
  Cache-Control: public, max-age=31536000, immutable

/pdf/6.2.108/worker/*.mjs
  Content-Type: text/javascript

/pdf/6.2.108/cmaps/*
  Content-Type: application/octet-stream

# Keep these rules disjoint: Cloudflare joins duplicate header values.
/pdf/6.2.108/standard_fonts/*.pfb
  Content-Type: application/octet-stream

/pdf/6.2.108/standard_fonts/LICENSE_*
  Content-Type: application/octet-stream

/pdf/6.2.108/standard_fonts/*.ttf
  Content-Type: font/ttf

/pdf/6.2.108/iccs/*
  Content-Type: application/octet-stream

/pdf/6.2.108/wasm/*.wasm
  Content-Type: application/wasm

/pdf/6.2.108/wasm/*.js
  Content-Type: text/javascript

/pdf/6.2.108/wasm/LICENSE_*
  Content-Type: application/octet-stream

/pdf/6.2.108/PDFJS-LICENSE.txt
  Content-Type: text/plain

/steg/jpeg-v2-codec.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
